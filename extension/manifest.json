{
  "manifest_version": 3,
  "name": "Legacy Spell Updater for D&D Beyond",
  "short_name": "Legacy Spell Updater",
  "version": "0.1.0",
  "description": "Updates legacy (2014) spell links on D&D Beyond monster stat blocks to their 2024 (5.5e) versions.",
  "content_scripts": [
    {
      "matches": ["*://www.dndbeyond.com/monsters/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["spell-map.json"], "matches": ["*://www.dndbeyond.com/*"] }
  ]
}
