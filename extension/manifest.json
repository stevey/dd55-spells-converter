{
  "manifest_version": 3,
  "name": "Legacy Spell Updater for D&D Beyond",
  "short_name": "Legacy Spell Updater",
  "version": "0.3.0",
  "description": "Updates legacy (2014) spell links in D&D Beyond monster stat blocks and the encounter builder to their 2024 (5.5e) versions.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Legacy Spell Updater",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.dndbeyond.com/monsters/*",
        "*://www.dndbeyond.com/encounter-builder*",
        "*://www.dndbeyond.com/encounters/*",
        "*://www.dndbeyond.com/combat-tracker/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["spell-map.json"], "matches": ["*://www.dndbeyond.com/*"] }
  ]
}
